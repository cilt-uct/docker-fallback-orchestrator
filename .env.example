# Opencast admin node, as reached by the controller process itself.
OPENCAST_HOST=octestallinone.virtuos.uos.de
OPENCAST_PROTOCOL=https
OPENCAST_USERNAME=opencast_system_account
OPENCAST_PASSWORD=CHANGE_ME

# Opencast, as reached from inside a managed PyCA container. Only set these
# if that differs from OPENCAST_HOST/OPENCAST_PROTOCOL above.
#OPENCAST_CONTAINER_HOST=host.docker.internal:8080
#OPENCAST_CONTAINER_PROTOCOL=http

# MySQL (controller state)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=pyca_orchestrator
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=pyca_orchestrator

# PyCA
PYCA_IMAGE=quay.io/opencast/pyca

# Directory (on the Docker host) where per-instance pyca.conf /
# docker-compose.yaml / recordings live. One subdirectory per instance.
INSTANCES_DIR=./instances

# Port range the controller allocates pyca-ui ports from
UI_PORT_RANGE_START=9000
UI_PORT_RANGE_END=9100

# Decision engine tuning
POLL_INTERVAL_SECONDS=60
# How many days ahead to pull scheduled events for
SCHEDULE_LOOKAHEAD_DAYS=1
# Spin up a backup once a scheduled event starts within this many minutes
RECORDING_LEAD_MINUTES=15
# Consider a capture agent offline if it hasn't reported in this long
AGENT_OFFLINE_SECONDS=300
