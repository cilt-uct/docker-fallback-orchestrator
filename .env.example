# Opencast admin node, as reached by the controller process itself.
OPENCAST_HOST=octestallinone.virtuos.uos.de
OPENCAST_PROTOCOL=https
OPENCAST_USERNAME=opencast_system_account
OPENCAST_PASSWORD=CHANGE_ME

# Opencast, as reached from inside a managed PyCA container. Only set these
# if that differs from OPENCAST_HOST/OPENCAST_PROTOCOL above.
#OPENCAST_CONTAINER_HOST=host.docker.internal:8080
#OPENCAST_CONTAINER_PROTOCOL=http

# MySQL (controller state). docker-compose.yml's mysql service reads
# MYSQL_PASSWORD/MYSQL_ROOT_PASSWORD from this same file (via Docker
# Compose's own .env substitution) - generate real values, e.g.
# `openssl rand -base64 24`, rather than leaving a placeholder; the
# compose file refuses to start if either is unset.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=pyca_orchestrator
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=pyca_orchestrator

# The controller refuses to start while OPENCAST_PASSWORD or MYSQL_PASSWORD is
# still CHANGE_ME. Only for a local dev stack that really uses CHANGE_ME as its
# password: set this to start anyway, with a warning. Never in production.
#ALLOW_PLACEHOLDER_SECRETS=true

# PyCA
PYCA_IMAGE=quay.io/opencast/pyca
# If backups log "SSL certificate problem: self signed certificate in certificate
# chain", the PyCA image doesn't trust Opencast's certificate. Give them the server's
# CA bundle (a path on the Docker host):
#PYCA_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Directory (on the Docker host) where per-instance pyca.conf /
# docker-compose.yaml / PyCA state live. One subdirectory per instance.
INSTANCES_DIR=./instances

# Where recordings are stored on the server, one subdirectory per venue:
# <RECORDINGS_DIR>/<venue>/recording-<start>-<mediapackage>/recording-....mp4
# For local development, use the git-ignored ./recordings instead.
RECORDINGS_DIR=/data/pyca-recordings

# Port range the controller allocates pyca-ui ports from
UI_PORT_RANGE_START=9000
UI_PORT_RANGE_END=9100

# Decision engine tuning
POLL_INTERVAL_SECONDS=60
# How many days ahead to pull scheduled events for
SCHEDULE_LOOKAHEAD_DAYS=1
# Consider a capture agent offline if it hasn't reported in this long
AGENT_OFFLINE_SECONDS=300
# A lecture needs a backup if its agent was down (offline or unhealthy) at any
# point within this many hours before it starts. A backup is only torn down
# once its agent has been continuously healthy for this long...
AGENT_STABLE_HOURS=24
# ...and this many days have passed since the last lecture that needed it.
BACKUP_RETENTION_DAYS=4

# Recordings clean-up: delete backup recordings this many days after they
# started - ingested or not - unless a different retention is set for that
# recording on the dashboard's Recordings page. Checked this often:
RECORDING_RETENTION_DAYS=7
RECORDING_CLEANUP_INTERVAL_MINUTES=60

# Give up on a single `docker compose` command (up/down/restart) after this
# long, so a hung Docker daemon can't stall the controller indefinitely
COMPOSE_TIMEOUT_SECONDS=300

# --- Running the controller in Docker: docker compose up -d --build controller ---
#
# Inside the container "localhost" is the container itself, so anything set to
# localhost above needs its address as seen from the container instead:
# the mysql service in docker-compose.yml...
#CONTROLLER_MYSQL_HOST=mysql
# ...or an Opencast running on the Docker host.
#CONTROLLER_OPENCAST_HOST=host.docker.internal:8080
#
# The controller starts backups through the host's Docker, so these folders are
# mounted at the same absolute path inside the container as on the host. Use
# absolute paths. Defaults: ./instances next to docker-compose.yml, and
# /data/pyca-recordings.
#INSTANCES_HOST_DIR=/srv/pyca-orchestrator/instances
#RECORDINGS_HOST_DIR=/data/pyca-recordings
#
# Local development (Docker Desktop) with the bundled MySQL and the dev
# Opencast stack - uncomment these four, using your own absolute project path.
# (Docker Desktop can't mount /data without extra setup, hence ./recordings.)
#CONTROLLER_MYSQL_HOST=mysql
#CONTROLLER_OPENCAST_HOST=host.docker.internal:8080
#ALLOW_PLACEHOLDER_SECRETS=true
#RECORDINGS_HOST_DIR=/Users/<you>/path/to/pyca-orchestrator/recordings
