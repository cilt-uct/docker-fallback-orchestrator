###
# pyCA Configuration - generated by pyca-orchestrator, do not edit by hand.
# Instance: $venue (backing up agent: $agent_id)
##

[agent]
name             = '$agent_id'
update_frequency = 30
cal_lookahead    = 1

# Backup mode: don't register with Opencast under our own name, just poll
# the schedule for $agent_id and step in when the orchestrator starts us.
backup_mode      = True
database         = 'sqlite:///pyca.db'


[capture]
directory        = './recordings'
preview_dir      = './recordings'

# Pull the venue's RTSP source directly. {{time}}/{{dir}}/{{name}} are pyCA's
# own substitution placeholders, not ours - left as literal text here.
command          = 'ffmpeg -nostats -y -rtsp_transport tcp -i $rtsp_source -t {{time}} -c:v copy -c:a aac {{dir}}/{{name}}.mkv'
flavors          = 'presenter/source'
files            = '{{dir}}/{{name}}.mkv'


[server]
url              = '$opencast_url'
username         = '$opencast_username'
password         = '$opencast_password'


[ui]
username         = '$ui_username'
password         = '$ui_password'
url              = 'http://localhost:$ui_port'


[logging]
stderr           = True
level            = info
