# Bind mounts, not named volumes, so the controller reads everything straight off
# the host without going through the Docker API:
#   ./data -> /var/lib/pyca             PyCA's state (its sqlite database)
#   {{ recordings_dir }} -> /var/lib/pyca/recordings   this venue's recordings
#     (RECORDINGS_DIR/<venue>, kept apart from the instance's Docker state)
# Containers are named pyca-<venue>-<service> (e.g. pyca-lt1-capture) so they're easy
# to find in `docker ps`; the controller itself finds them by the compose project label.
services:
  pyca-schedule:
    container_name: {{ compose_project }}-schedule
    command: schedule
    image: {{ pyca_image }}
    restart: unless-stopped
    environment:
      - TZ=Africa/Johannesburg
    volumes:
      - ./pyca.conf:/etc/pyca/pyca.conf:ro
      - ./data:/var/lib/pyca
      - "{{ recordings_dir }}:/var/lib/pyca/recordings"
{%- if ca_bundle %}
      - "{{ ca_bundle }}:{{ ca_bundle_mount }}:ro"
{%- endif %}

  pyca-ingest:
    container_name: {{ compose_project }}-ingest
    command: ingest
    image: {{ pyca_image }}
    restart: unless-stopped
    environment:
      - TZ=Africa/Johannesburg
    volumes:
      - ./pyca.conf:/etc/pyca/pyca.conf:ro
      - ./data:/var/lib/pyca
      - "{{ recordings_dir }}:/var/lib/pyca/recordings"
{%- if ca_bundle %}
      - "{{ ca_bundle }}:{{ ca_bundle_mount }}:ro"
{%- endif %}

  pyca-capture:
    container_name: {{ compose_project }}-capture
    command: capture
    image: {{ pyca_image }}
    restart: unless-stopped
    environment:
      - TZ=Africa/Johannesburg
    volumes:
      - ./pyca.conf:/etc/pyca/pyca.conf:ro
      - ./data:/var/lib/pyca
      - "{{ recordings_dir }}:/var/lib/pyca/recordings"
{%- if ca_bundle %}
      - "{{ ca_bundle }}:{{ ca_bundle_mount }}:ro"
{%- endif %}

  pyca-agentstate:
    container_name: {{ compose_project }}-agentstate
    command: agentstate
    image: {{ pyca_image }}
    restart: unless-stopped
    environment:
      - TZ=Africa/Johannesburg
    volumes:
      - ./pyca.conf:/etc/pyca/pyca.conf:ro
      - ./data:/var/lib/pyca
      - "{{ recordings_dir }}:/var/lib/pyca/recordings"
{%- if ca_bundle %}
      - "{{ ca_bundle }}:{{ ca_bundle_mount }}:ro"
{%- endif %}

  pyca-ui:
    container_name: {{ compose_project }}-ui
    entrypoint: ["gunicorn", "--config=/etc/pyca/gunicorn.conf.py", "pyca.ui:app"]
    image: {{ pyca_image }}
    restart: unless-stopped
    environment:
      - TZ=Africa/Johannesburg
    volumes:
      - ./pyca.conf:/etc/pyca/pyca.conf:ro
      - ./data:/var/lib/pyca
      - "{{ recordings_dir }}:/var/lib/pyca/recordings"
{%- if ca_bundle %}
      - "{{ ca_bundle }}:{{ ca_bundle_mount }}:ro"
{%- endif %}
    ports:
      - "{{ ui_port }}:8000"
